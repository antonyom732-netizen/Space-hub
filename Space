	UI.Button(p3, "Sentar / Levantar", "Alterna estado sentado", F.Sit)
	UI.Button(p3, "Respawn", "Reinicia personagem", function() F.Reset(); Notify("Reiniciando...") end)

	local p4 = Tab("Visual", "[O]")
	local fovS = UI.Slider(p4, "FOV", 40, 120, 70, F.FOV)
	UI.Toggle(p4, "FullBright", "Brilho máximo local", false, F.FullBright)
	UI.Slider(p4, "Horário", 0, 24, 14, F.Time)
	UI.Toggle(p4, "ESP Jogadores", "Destaque local em roxo", false, F.ESP)

	local p5 = Tab("Utilidades", "[U]")
