local VisTab = Window:CreateTab("Visual", 4483362458)
local espCache = {}

local function addESP(plr)
    if plr == player or not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if espCache[plr] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(0, 170, 255)
    hl.FillTransparency = 0.5
    hl.OutlineColor = Color3.new(1,1,1)
    hl.Parent = plr.Character
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0,200,0,50)
    bb.StudsOffset = Vector3.new(0,3,0)
    bb.AlwaysOnTop = true
    bb.Parent = hrp
    local t = Instance.new("TextLabel")
    t.Size = UDim2.fromScale(1,1)
    t.BackgroundTransparency = 1
    t.TextColor3 = Color3.new(1,1,1)
    t.TextStrokeTransparency = 0
    t.Text = plr.Name
    t.Parent = bb
    espCache[plr] = {hl, bb}
end

local function clearESP(plr)
    local c = espCache[plr]
    if c then
        for _, o in ipairs(c) do pcall(function() o:Destroy() end) end
        espCache[plr] = nil
    end
end

VisTab:CreateToggle({
    Name = "Player Highlight (ESP local)",
    Flag = "espT",
    CurrentValue = false,
    Callback = function(v)
        S.esp = v
        if v then
            for _, p in ipairs(Players:GetPlayers()) do addESP(p) end
            Players.PlayerAdded:Connect(function(p)
                if S.esp then
                    p.CharacterAdded:Connect(function()
                        task.wait(1)
                        if S.esp then addESP(p) end
                    end)
                end
            end)
        else
            for p, _ in pairs(espCache) do clearESP(p) end
        end
    end,
})

VisTab:CreateToggle({
    Name = "Fullbright",
    Flag = "fbT",
    CurrentValue = false,
    Callback = function(v)
        S.fullbright = v
        if v then
            Lighting.Ambient = Color3.new(1,1,1)
            Lighting.OutdoorAmbient = Color3.new(1,1,1)
            Lighting.Brightness = 2
        else
            Lighting.Ambient = Color3.fromRGB(70,70,70)
            Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
            Lighting.Brightness = 1
        end
    end,
})

VisTab:CreateSlider({
    Name = "Campo de Visão (FOV)",
    Range = {40, 120}, Increment = 1,
    Flag = "fovS", CurrentValue = 70,
    Callback = function(v)
        Workspace.CurrentCamera.FieldOfView = v
    end,
})

