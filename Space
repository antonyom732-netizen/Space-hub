function F.CarTorque(v) local s = seat(); if s then s.Torque = v; return true end; return false end
function F.FlipCar() local s = seat(); if s and s.Parent then local m = s:FindFirstAncestorOfClass("Model") or s; m:PivotTo(CFrame.new(m:GetPivot().Position + Vector3.new(0,4,0))); return true end; return false end
function F.Spin(on) clr("sp"); if on then Conn.sp = RunService.RenderStepped:Connect(function(dt) local r = root(); if r then r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(18*60*dt), 0) end end) end end
function F.Reset() local h = hum(); if h then h.Health = 0 end end
function F.Sit() local h = hum(); if h then h.Sit = not h.Sit end end
function F.FOV(v) if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = v end end
function F.FullBright(on)
	if on then Lighting.Ambient = Color3.fromRGB(200,200,200); Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200); Lighting.Brightness = 2; Lighting.FogEnd = 100000
	else Lighting.Ambient = DefLight.Ambient; Lighting.OutdoorAmbient = DefLight.OutdoorAmbient; Lighting.Brightness = DefLight.Brightness; Lighting.FogEnd = DefLight.FogEnd end
end
function F.Time(v) Lighting.ClockTime = v end
function F.ESP(on)
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then local old = p.Character:FindFirstChild("SpaceHubHighlight"); if old then old:Destroy() end end end
	clr("esp"); if not on then return end
	local function add(c)
		if not c or c == LocalPlayer.Character or c:FindFirstChild("SpaceHubHighlight") then return end
		local hl = Instance.new("Highlight"); hl.Name = "SpaceHubHighlight"; hl.FillColor = Config.Theme.Accent; hl.OutlineColor = Config.Theme.TextPrimary; hl.FillTransparency = 0.65; hl.OutlineTransparency = 0.2; hl.Parent = c
	end
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then add(p.Character) end end
	Conn.esp = RunService.Heartbeat:Connect(function() for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then add(p.Character) end end end)
end
function F.AntiAFK(on) clr("afk"); if on then Conn.afk = LocalPlayer.Idled:Connect(function() VirtualUser:CaptureController(); VirtualUser:ClickButton2(Vector2.new()) end) end end
function F.FPS()
	Lighting.GlobalShadows = false
	for _, o in ipairs(Workspace:GetDescendants()) do
		if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke") or o:IsA("Fire") then o.Enabled = false
		elseif o:IsA("BasePart") then o.CastShadow = false end
	end
end
