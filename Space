	corner(knob, 99)
	local function apply(v, anim)
		state = v
		local tp = anim and tw or function(o,t,pr) for k,val in pairs(pr) do o[k]=val end end
		tp(pill, .16, {BackgroundColor3 = v and W or Color3.fromRGB(40,40,40)})
