	local vl = Instance.new("TextLabel"); vl.Size = UDim2.new(0.3,-12,0,20); vl.Position = UDim2.new(1,-12,0,6); vl.AnchorPoint = Vector2.new(1,0); vl.BackgroundTransparency = 1; vl.Text = tostring(cur); vl.Font = Config.FontMain; vl.TextSize = 13; vl.TextColor3 = Config.Theme.AccentLight; vl.TextXAlignment = Enum.TextXAlignment.Right; vl.Parent = card
	local tr = Instance.new("TextButton"); tr.Size = UDim2.new(1,-24,0,8); tr.Position = UDim2.new(0,12,0,34); tr.BackgroundColor3 = Config.Theme.Background; tr.AutoButtonColor = false; tr.Text = ""; tr.Parent = card; UI.Corner(tr, 4)
	local fl = Instance.new("Frame"); fl.Size = UDim2.new((cur-minV)/(maxV-minV),0,1,0); fl.BackgroundColor3 = Config.Theme.AccentLight; fl.BorderSizePixel = 0; fl.Parent = tr; UI.Corner(fl, 4)
	local drag = false
	local function setPos(x)
		local r = math.clamp((x - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
		cur = math.floor(minV + (maxV - minV) * r); vl.Text = tostring(cur); fl.Size = UDim2.new(r,0,1,0)
		if cb then cb(cur) end
	end
	tr.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true; setPos(i.Position.X) end end)
	UserInputService.InputChanged:Connect(function(i) if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setPos(i.Position.X) end end)
	UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)
	return {SetValue = function(v) cur = math.clamp(v, minV, maxV); vl.Text = tostring(cur); fl.Size = UDim2.new((cur-minV)/(maxV-minV),0,1,0); if cb then cb(cur) end end}
end
local F, Conn = {}, {}
local DefLight = {Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, Brightness = Lighting.Brightness, FogEnd = Lighting.FogEnd}
local function hum() local c = LocalPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function root() local c = LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function seat() local h = hum(); return (h and h.SeatPart and h.SeatPart:IsA("VehicleSeat")) and h.SeatPart or nil end
local function clr(k) if Conn[k] then Conn[k]:Disconnect(); Conn[k] = nil end end

function F.Walk(v) local h = hum(); if h then h.WalkSpeed = v end end
function F.Jump(v) local h = hum(); if h then h.UseJumpPower = true; h.JumpPower = v end end
function F.InfJump(on) clr("ij"); if on then Conn.ij = UserInputService.JumpRequest:Connect(function() local h = hum(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end) end end
