local function showLoading()
    local sg = Instance.new("ScreenGui")
    sg.Name = "SpaceHubLoad"
    sg.IgnoreGuiInset = true
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 10000
    sg.Parent = player:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.Parent = sg

    -- Buraco negro central
    local hole = Instance.new("Frame")
    hole.AnchorPoint = Vector2.new(0.5, 0.5)
    hole.Position = UDim2.fromScale(0.5, 0.42)
    hole.Size = UDim2.fromOffset(120, 120)
    hole.BackgroundColor3 = Color3.new(0, 0, 0)
    hole.BorderSizePixel = 0
    hole.Parent = bg
    Instance.new("UICorner", hole).CornerRadius = UDim.new(1, 0)

    -- Anel de acreção
    local ring = Instance.new("Frame")
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromScale(0.5, 0.42)
    ring.Size = UDim2.fromOffset(180, 180)
    ring.BackgroundColor3 = Color3.new(1, 1, 1)
    ring.BackgroundTransparency = 0.75
    ring.BorderSizePixel = 0
    ring.Parent = bg
    Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
    local ringGrad = Instance.new("UIGradient")
    ringGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    ringGrad.Parent = ring

    -- Partículas orbitando
    local parts = {}
    for i = 1, 60 do
        local p = Instance.new("Frame")
        p.Size = UDim2.fromOffset(2, 2)
        p.BackgroundColor3 = Color3.new(1, 1, 1)
        p.BackgroundTransparency = math.random(30, 90) / 100
        p.BorderSizePixel = 0
        p.Parent = bg
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
        parts[i] = {
            f = p,
            a = math.random() * math.pi * 2,
            r = math.random(100, math.max(200, math.floor(bg.AbsoluteSize.X/2))),
            s = (math.random() - 0.5) * 1.5,
            ay = 0.5 + math.random() * 0.4,
        }
    end

    -- Textos
    local function makeLabel(posY, text, size, font, color, spacing)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, size + 10)
        l.Position = UDim2.new(0, 0, 0, posY)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = color
        l.Font = font
        l.TextSize = size
        l.TextTransparency = 1
        if spacing then
            l.Text = table.concat({text:byte(1, #text)}, "") -- no-op, mantém compatibilidade
        end
        l.Parent = bg
        return l
    end

    local title    = makeLabel(bg.AbsoluteSize.Y * 0.42 + 80, "SPACE HUB", 46, Enum.Font.GothamBlack, Color3.new(1,1,1))
    local subtitle = makeLabel(bg.AbsoluteSize.Y * 0.42 + 140, "BEYOND THE LIMITS", 14, Enum.Font.Gotham, Color3.fromRGB(180,180,180))

    -- Barra de progresso
    local barBg = Instance.new("Frame")
    barBg.AnchorPoint = Vector2.new(0.5, 0.5)
    barBg.Position = UDim2.new(0.5, 0, 0.86, 0)
    barBg.Size = UDim2.fromOffset(math.min(320, bg.AbsoluteSize.X - 60), 4)
    barBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    barBg.BorderSizePixel = 0
    barBg.Parent = bg
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.new(1, 1, 1)
    barFill.BorderSizePixel = 0
    barFill.Parent = barBg
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

    local pct = Instance.new("TextLabel")
    pct.AnchorPoint = Vector2.new(0.5, 0)
    pct.Position = UDim2.new(0.5, 0, 0.86, 12)
    pct.Size = UDim2.fromOffset(100, 16)
    pct.BackgroundTransparency = 1
    pct.Text = "0%"
    pct.TextColor3 = Color3.fromRGB(180,180,180)
    pct.Font = Enum.Font.Gotham
    pct.TextSize = 11
    pct.Parent = bg

    local msg = Instance.new("TextLabel")
    msg.AnchorPoint = Vector2.new(0.5, 0)
    msg.Position = UDim2.new(0.5, 0, 0.90, 8)
    msg.Size = UDim2.fromOffset(300, 16)
    msg.BackgroundTransparency = 1
    msg.Text = "Inicializando..."
    msg.TextColor3 = Color3.fromRGB(100,100,100)
    msg.Font = Enum.Font.Gotham
    msg.TextSize = 10
    msg.Parent = bg

    -- Loop de animação
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        local cx, cy = bg.AbsoluteSize.X * 0.5, bg.AbsoluteSize.Y * 0.42
        for _, p in pairs(parts) do
            p.a = p.a + p.s * dt
            local x = cx + math.cos(p.a) * p.r
            local y = cy + math.sin(p.a) * p.r * p.ay
            p.f.Position = UDim2.fromOffset(x, y)
        end
        ringGrad.Rotation = (ringGrad.Rotation + dt * 90) % 360
    end)

    -- Fade-in do título
    TweenService:Create(title,    TweenInfo.new(1.2), {TextTransparency = 0}):Play()
    task.wait(0.4)
    TweenService:Create(subtitle, TweenInfo.new(1.2), {TextTransparency = 0}):Play()

    -- Progresso real
    local steps = {
        "Estabelecendo conexão...",
        "Localizando horizonte de eventos...",
        "Sincronizando módulos...",
        "Calibrando sistema visual...",
        "Estabilizando campo...",
        "Pronto.",
    }
    for i = 1, 100 do
        TweenService:Create(barFill, TweenInfo.new(0.04), {Size = UDim2.new(i/100, 0, 1, 0)}):Play()
        pct.Text = i .. "%"
        if i % 20 == 0 then
            msg.Text = steps[math.min(i//20, #steps)] or steps[#steps]
        end
        task.wait(0.02)
    end

    task.wait(0.4)
    conn:Disconnect()

    -- Fade-out
    local fadeT = TweenInfo.new(0.9)
    TweenService:Create(bg, fadeT, {BackgroundTransparency = 1}):Play()
    for _, o in pairs({title, subtitle, pct, msg, hole, ring, barBg}) do
        pcall(function()
            if o:IsA("Frame") then
                TweenService:Create(o, fadeT, {BackgroundTransparency = 1}):Play()
            else
                TweenService:Create(o, fadeT, {TextTransparency = 1}):Play()
            end
        end)
    end
    task.wait(1)
    sg:Destroy()
end

