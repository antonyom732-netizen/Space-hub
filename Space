function UI.Slider(parent, text, minV, maxV, defV, cb)
	local cur = math.clamp(defV or minV, minV, maxV)
	local card = Instance.new("Frame"); card.Size = UDim2.new(1,-8,0,54); card.BackgroundColor3 = Config.Theme.Element; card.Parent = parent; UI.Corner(card, 6); UI.Stroke(card, Config.Theme.Stroke, 1)
