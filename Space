-- // TROLL
local function tpTo(cf) local r = hrp(); if r then r.CFrame = cf end end
local function bring(pl)
	local tr = chrOf(pl); local r = hrp()
	if tr and r then tr.CFrame = r.CFrame * CFrame.new(math.random(-6,6), 0, math.random(-6,6)) end
end
local function kill(pl)
	local tr, th = chrOf(pl)
	if not tr then return end
	tr.CFrame = CFrame.new(0, 600, 0)
	if th then th.Health = 0 end
	task.delay(.6, function() if tr and tr.Parent then tr.CFrame = CFrame.new(0, 5, 0) end end)
end
local function fling(pl)
	local tr = chrOf(pl); if not tr then return end
	local bv = new("BodyVelocity", {MaxForce=Vector3.new(1e5,1e5,1e5), Velocity=Vector3.new(math.random(-300,300), 400, math.random(-300,300))}, tr)
	local ba = new("BodyAngularVelocity", {MaxTorque=Vector3.new(1e6,1e6,1e6), AngularVelocity=Vector3.new(math.random(-30,30),math.random(-30,30),math.random(-30,30))}, tr)
	task.delay(1.2, function() if bv then bv:Destroy() end; if ba then ba:Destroy() end end)
end
local function launch(pl)
	local tr = chrOf(pl); if not tr then return end
	tr.CFrame = tr.CFrame + Vector3.new(0, 250, 0)
end
local function explode(pl)
	local tr = chrOf(pl); if not tr then return end
	local e = new("Explosion", {Position=tr.Position, BlastRadius=14, DestroyJointRadiusPercent=0, BlastPressure=0}, workspace)
	task.delay(2, function() e:Destroy() end)
end
local function release(pl)
	local _, th = chrOf(pl)
	if State.freeze then State.freeze[pl] = nil end
	if th then th.PlatformStand = false end
	if State.jail and State.jail[pl] then for _,p in ipairs(State.jail[pl]) do p:Destroy() end; State.jail[pl] = nil end
end
local function freeze(pl)
	if State.freeze and State.freeze[pl] then release(pl); return end
	State.freeze = State.freeze or {}
	State.freeze[pl] = true
	local tr, th = chrOf(pl); if not tr then return end
	if th then th.PlatformStand = true end
	local saved = tr.CFrame
	task.spawn(function()
		while State.freeze[pl] and tr.Parent do
			tr.CFrame = saved
			task.wait()
		end
	end)
end
local function jail(pl)
	if State.jail and State.jail[pl] then release(pl); return end
	local tr = chrOf(pl); if not tr then return end
	State.jail = State.jail or {}
	State.jail[pl] = {}
	local function wall(off, size)
		local p = new("Part", {Anchored=true, CanCollide=true, Size=size, CFrame=tr.CFrame * off, Material=Enum.Material.ForceField, Color=W, Transparency=.25, Parent=workspace})
		table.insert(State.jail[pl], p)
	end
	wall(CFrame.new(0,4,-4), Vector3.new(9,8,.4))
	wall(CFrame.new(0,4,4), Vector3.new(9,8,.4))
	wall(CFrame.new(-4,4,0), Vector3.new(.4,8,9))
	wall(CFrame.new(4,4,0), Vector3.new(.4,8,9))
	wall(CFrame.new(0,8,0), Vector3.new(9,.4,9))
end

-- // VEÍCULOS
local function vehicles()
	local out = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("VehicleSeat") then
			local m = d:FindFirstAncestorOfClass("Model")
			if m and not table.find(out, m) then table.insert(out, m) end
		end
	end
	return out
end
local function bringCar()
	local r = hrp(); if not r then return end
	local list = vehicles()
	if #list == 0 then Notify("Nenhum veículo no mapa", "err") return end
	local best, dist = nil, math.huge
	for _, m in ipairs(list) do
		local pp = m:FindFirstChildWhichIsA("BasePart", true)
		if pp then
			local d = (pp.Position - r.Position).Magnitude
			if d < dist then best, dist = m, d end
		end
	end
	if best then
		local pp = best:FindFirstChildWhichIsA("BasePart", true)
		if pp then best:PivotTo(r.CFrame * CFrame.new(0, 0, -8)); Notify("Veículo trazido") end
	end
end
local function bringAllCars()
	local r = hrp(); if not r then return end
	for i, m in ipairs(vehicles()) do
		local pp = m:FindFirstChildWhichIsA("BasePart", true)
		if pp then m:PivotTo(r.CFrame * CFrame.new(math.random(-10,10), 0, -10 - i)) end
	end
	Notify("Veículos agrupados")
end

