-- Fly (funciona de verdade — BodyVelocity + BodyGyro)
local flyConns = {}
PlayerTab:CreateToggle({ Name="Fly (voo)", Flag="flyT", CurrentValue=false,
    Callback=function(v)
        S.fly = v
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        if v then
            hum.PlatformStand = true
            local bv = Instance.new("BodyVelocity")
            bv.Name = "SH_FlyBV"; bv.MaxForce = Vector3.new(1e5,1e5,1e5); bv.Velocity = Vector3.zero
            bv.Parent = hrp
            local bg = Instance.new("BodyGyro")
            bg.Name = "SH_FlyBG"; bg.P = 9e4; bg.MaxTorque = Vector3.new(9e4,9e4,9e4); bg.CFrame = hrp.CFrame
            bg.Parent = hrp
            table.insert(flyConns, RunService.RenderStepped:Connect(function()
                if not S.fly then return end
                local cam = Workspace.CurrentCamera
                local mv  = hum.MoveDirection
                local dir = (cam.CFrame.LookVector * -mv.Z) + (cam.CFrame.RightVector * mv.X)
                bv.Velocity = dir * S.flySpd
                bg.CFrame   = cam.CFrame
            end))
        else
            hum.PlatformStand = false
            for _, c in pairs(flyConns) do pcall(function() c:Disconnect() end) end
            flyConns = {}
            local h = char:FindFirstChild("HumanoidRootPart")
            if h then
                if h:FindFirstChild("SH_FlyBV") then h.SH_FlyBV:Destroy() end
                if h:FindFirstChild("SH_FlyBG") then h.SH_FlyBG:Destroy() end
            end
        end
    end })
