local SetTab = Window:CreateTab("Settings", 4483362458)

SetTab:CreateSection("Conta")
SetTab:CreateButton({ Name="Rejoin no Servidor Atual",
    Callback=function()
        TeleportSrv:Teleport(game.PlaceId, player)
    end })

SetTab:CreateButton({ Name="Server Hop",
    Callback=function()
        local url = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if not ok then
            Rayfield:Notify({Title="Hop", Content="Falha na requisição.", Duration=3})
            return
        end
        local data = HttpService:JSONDecode(res)
        for _, srv in pairs(data.data or {}) do
            if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                TeleportSrv:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                return
            end
        end
        Rayfield:Notify({Title="Hop", Content="Nenhum servidor disponível.", Duration=3})
    end })

SetTab:CreateSection("Interface")
SetTab:CreateButton({ Name="Destruir Menu",
    Callback=function() Rayfield:Destroy() end })

SetTab:CreateButton({ Name="Resetar Configurações",
    Callback=function()
        Rayfield:Notify({
            Title = "Settings",
            Content = "Config salva automaticamente em SpaceHub/config. Reabra o script para recarregar.",
            Duration = 4,
        })
    end })

