local VehTab = Window:CreateTab("Vehicles", 6040425499)

VehTab:CreateSection("Veículos no Servidor")
local function scanVehicles()
    local list = {}
    for _, d in pairs(Workspace:GetDescendants()) do
        if d:IsA("Model") and (d:FindFirstChildOfClass("VehicleSeat") or d.Name:lower():find("vehicle") or d.Name:lower():find("car")) then
            table.insert(list, d)
        end
    end
    return list
end

VehTab:CreateButton({ Name="Listar e Teleportar ao Veículo Mais Próximo",
    Callback=function()
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local vehicles = scanVehicles()
        if #vehicles == 0 then
            Rayfield:Notify({Title="Veículos", Content="Nenhum veículo encontrado.", Duration=3})
            return
        end
        local best, bestD = nil, math.huge
        for _, v in ipairs(vehicles) do
            local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if part then
                local d = (part.Position - hrp.Position).Magnitude
                if d < bestD then best, bestD = v, d end
            end
        end
        if best then
            local part = best.PrimaryPart or best:FindFirstChildWhichIsA("BasePart")
            if part then
                hrp.CFrame = part.CFrame + Vector3.new(0, 5, 5)
            end
        end
    end })

VehTab:CreateButton({ Name="Recolorir Meu Veículo Próximo (local)",
    Callback=function()
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local vehicles = scanVehicles()
        for _, v in ipairs(vehicles) do
            local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
            if part and (part.Position - hrp.Position).Magnitude < 20 then
                for _, p in pairs(v:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "Window" and not p.Name:lower():find("glass") then
                        pcall(function() p.Color = Color3.fromRGB(20, 20, 20) end)
                    end
                end
                Rayfield:Notify({Title="Veículo", Content="Recolorido localmente.", Duration=2})
                return
            end
        end
        Rayfield:Notify({Title="Veículo", Content="Aproxime-se de um veículo (20 studs).", Duration=3})
    end })

VehTab:CreateButton({ Name="Contagem de Veículos no Servidor",
    Callback=function()
