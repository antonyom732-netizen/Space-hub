	UI.Slider(p2, "Torque", 1000, 25000, 5000, F.CarTorque)
	UI.Button(p2, "Desvirar Carro", "Endireita o veículo", function() Notify(F.FlipCar() and "Desvirado!" or "Entre no veículo.") end)

