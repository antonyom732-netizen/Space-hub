	local sLay = Instance.new("UIListLayout"); sLay.Padding = UDim.new(0,6); sLay.HorizontalAlignment = Enum.HorizontalAlignment.Center; sLay.Parent = Side
	local sPad = Instance.new("UIPadding"); sPad.PaddingTop = UDim.new(0,10); sPad.PaddingBottom = UDim.new(0,10); sPad.Parent = Side
	local Pages = Instance.new("Frame"); Pages.Size = UDim2.new(1,-146,1,-12); Pages.Position = UDim2.new(0,142,0,6); Pages.BackgroundTransparency = 1; Pages.Parent = Body

	local Tabs = {}
	local function Tab(name, ico)
		local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1,-16,0,34); btn.BackgroundColor3 = Config.Theme.Element; btn.BackgroundTransparency = 1; btn.AutoButtonColor = false; btn.Text = ""; btn.Parent = Side; UI.Corner(btn, 6)
		local ind = Instance.new("Frame"); ind.Size = UDim2.new(0,3,0.6,0); ind.Position = UDim2.new(0,0,0.5,0); ind.AnchorPoint = Vector2.new(0,0.5); ind.BackgroundColor3 = Config.Theme.AccentLight; ind.Visible = false; ind.Parent = btn; UI.Corner(ind, 2)
		local il = Instance.new("TextLabel"); il.Size = UDim2.new(0,22,1,0); il.Position = UDim2.new(0,8,0,0); il.BackgroundTransparency = 1; il.Text = ico; il.Font = Config.FontMain; il.TextSize = 14; il.TextColor3 = Config.Theme.TextSecondary; il.Parent = btn
		local nl = Instance.new("TextLabel"); nl.Size = UDim2.new(1,-34,1,0); nl.Position = UDim2.new(0,32,0,0); nl.BackgroundTransparency = 1; nl.Text = name; nl.Font = Config.FontBody; nl.TextSize = 12; nl.TextColor3 = Config.Theme.TextSecondary; nl.TextXAlignment = Enum.TextXAlignment.Left; nl.Parent = btn
		local pg = Instance.new("ScrollingFrame"); pg.Size = UDim2.new(1,0,1,0); pg.BackgroundTransparency = 1; pg.ScrollBarThickness = 3; pg.ScrollBarImageColor3 = Config.Theme.Accent; pg.CanvasSize = UDim2.new(0,0,0,0); pg.AutomaticCanvasSize = Enum.AutomaticSize.Y; pg.Visible = false; pg.Parent = Pages
		local pLay = Instance.new("UIListLayout"); pLay.Padding = UDim.new(0,8); pLay.Parent = pg
		local pPad = Instance.new("UIPadding"); pPad.PaddingTop = UDim.new(0,4); pPad.PaddingBottom = UDim.new(0,8); pPad.Parent = pg
		local td = {btn=btn, pg=pg, ind=ind, il=il, nl=nl}
		local function sel()
			for _, x in ipairs(Tabs) do x.pg.Visible = false; x.ind.Visible = false; TweenService:Create(x.btn, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play(); x.il.TextColor3 = Config.Theme.TextSecondary; x.nl.TextColor3 = Config.Theme.TextSecondary end
			pg.Visible = true; ind.Visible = true; TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play(); il.TextColor3 = Config.Theme.TextPrimary; nl.TextColor3 = Config.Theme.TextPrimary
		end
		btn.MouseButton1Click:Connect(sel); table.insert(Tabs, td); if #Tabs == 1 then sel() end; return pg
	end
	local p1 = Tab("Player", "[P]")
	local spS = UI.Slider(p1, "Velocidade", 16, 150, 16, F.Walk)
