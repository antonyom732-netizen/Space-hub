	local pill = new("TextButton", {Size=UDim2.fromOffset(38,18), Position=UDim2.new(1,-48,.5,0), AnchorPoint=Vector2.new(0,.5), BackgroundColor3=Color3.fromRGB(40,40,40), Text="", BorderSizePixel=0, AutoButtonColor=false}, row)
