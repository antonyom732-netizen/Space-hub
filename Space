-- // GAMEPASS SPOOF (módulo final)
-- ============================================================
local gpOn = false
local hooked = false

local function spoofNotify(txt)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "GamePass Spoof",
			Text = txt,
			Duration = 3
		})
	end)
end

local function spoofGp(on)
	if not getrawmetatable or not getnamecallmethod then return end
	pcall(function()
		local mt = getrawmetatable(game)
		setreadonly(mt, false)

		if not hooked then
			hooked = true
			local oldNamecall = mt.__namecall
			mt.__sh_old = oldNamecall

			local newNamecall = function(self, ...)
				local method = getnamecallmethod()

				if gpOn then
					if method == "UserOwnsGamePassAsync"
						or method == "PlayerOwnsAsset"
						or method == "PlayerHasPass"
						or method == "CheckUserOwnsAssetAsync" then
						return true
					end
				end

				return oldNamecall(self, ...)
			end

			mt.__namecall = (newcclosure and newcclosure(newNamecall)) or newNamecall
		end

		gpOn = on
		setreadonly(mt, true)
	end)
end

local function restoreGp()
	if not getrawmetatable then return end
	pcall(function()
		if not hooked then return end
		local mt = getrawmetatable(game)
		setreadonly(mt, false)
		mt.__namecall = mt.__sh_old
		mt.__sh_old = nil
		setreadonly(mt, true)
		hooked = false
		gpOn = false
	end)
end

-- liga já na execução
spoofGp(true)
spoofNotify("Spoof ATIVADO (G para alternar · H para remover)")

-- toggle por teclado
UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.G then
		spoofGp(not gpOn)
		spoofNotify(gpOn and "Spoof ATIVADO" or "Spoof DESATIVADO")
	elseif input.KeyCode == Enum.KeyCode.H then
		restoreGp()
		spoofNotify("Hook removido (restore)")
	end
end)

-- API de console
local api = {
	toggle = function(v) spoofGp(v == nil and not gpOn or v) end,
	on     = function() spoofGp(true) end,
	off    = function() spoofGp(false) end,
	remove = restoreGp,
	state  = function() return gpOn end
}
if getgenv then getgenv().GamePassSpoof = api end
_G.GamePassSpoof = api
