local function slider(p, txt, min, max, def, cb)
	local val = def or min
	local row = new("Frame", {Size=UDim2.new(1,-24,0,44), BackgroundColor3=G1, BorderSizePixel=0, LayoutOrder=#p:GetChildren()}, p)
	corner(row, 6); stroke(row, G2)
	new("TextLabel", {Size=UDim2.new(1,-24,0,16), Position=UDim2.new(0,10,0,5), BackgroundTransparency=1, Font=FONT2, TextSize=11, TextColor3=W, TextXAlignment=Enum.TextXAlignment.Left, Text=txt}, row)
	local lbl = new("TextLabel", {Size=UDim2.fromOffset(40,16), Position=UDim2.new(1,-50,0,5), BackgroundTransparency=1, Font=FONT2, TextSize=11, TextColor3=Color3.fromRGB(180,180,180), TextXAlignment=Enum.TextXAlignment.Right, Text=tostring(val)}, row)
	local track = new("Frame", {Size=UDim2.new(1,-24,0,4), Position=UDim2.new(0,12,0,30), BackgroundColor3=Color3.fromRGB(38,38,38), BorderSizePixel=0}, row)
	corner(track, 99)
	local fill = new("Frame", {Size=UDim2.fromScale((val-min)/(max-min),1), BackgroundColor3=W, BorderSizePixel=0}, track); corner(fill, 99)
	local grab = new("TextButton", {Size=UDim2.new(1,0,0,20), Position=UDim2.new(0,0,.5,-10), BackgroundTransparency=1, Text=""}, track)
	local dragging = false
	local function set(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		val = math.floor(min + (max-min)*a + .5)
		fill.Size = UDim2.fromScale(a, 1)
		lbl.Text = tostring(val)
		pcall(cb, val)
	end
	grab.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
	grab.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then set(i.Position.X) end end)
	grab.MouseButton1Click:Connect(function() set(UIS:GetMouseLocation().X) end)
	pcall(cb, val)
	return {Get = function() return val end, Set = function(v) val = v; fill.Size = UDim2.fromScale((v-min)/(max-min),1); lbl.Text = tostring(v); pcall(cb,v) end}
end
